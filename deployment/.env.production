# Production Environment Configuration
# ======================================
# NEVER commit this file to git.
# Copy to server and fill in real values.

OPENAI_API_KEY=your_real_openai_api_key
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=1024
OPENAI_TEMPERATURE=0.7

APP_NAME="Nepali Language Intelligent Chatbot"
APP_VERSION="1.0.0"
DEBUG=False

HOST=0.0.0.0
PORT=8000
MAX_HISTORY_LENGTH=20

DATABASE_URL=sqlite:///./data/chatbot.db

RAG_ENABLED=False
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=4
RAG_EMBEDDING_MODEL=text-embedding-3-small
DOCUMENTS_DIR=./data/documents
VECTOR_STORE_DIR=./data/vector_store

# CHANGE THIS — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-64-char-hex-string-generated-above
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

EVAL_OUTPUT_DIR=./evaluation/eval_results